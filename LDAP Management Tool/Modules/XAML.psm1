Add-Type -AssemblyName PresentationFramework, PresentationCore, WindowsBase -ErrorAction Stop

$XAMLVerbose = $True

#region Base Functions

function New-XAMLElement {
    param(
        [parameter(Position = 0)]
        [String] $ElementType,
        [parameter(Position = 1)]
        [hashtable]$Attributes,
        [parameter(Position = 2)]
        [String[]] $Content,
        [parameter(Position = 3)]
        [switch] $AsObject
    )
    Write-Verbose -Verbose:$XAMLVerbose -Message "[$(Get-Date)] [New-XAMLElement] $ElementType"

    if ($Attributes.Count -gt 0) {
        $AttributeString = ''
        :Attributes foreach ($Attribute in $Attributes.GetEnumerator()) {
            switch ($Attribute.Key) {
                'Content' { $Content = $Attribute.Value; continue Attributes }
                'OtherAttributes' { continue Attributes }
                'AsObject' { $AsObject = $Attribute.Value; continue Attributes }
            }
            if ($null -eq $Attribute.Value) { continue Attributes }
            $AttributeString += " $($Attribute.Key)=`"$($Attribute.Value)`""
        }
        if ($attributes.OtherAttributes.Count -gt 0) {
            :Attributes foreach ($Attribute in $Attributes.OtherAttributes.GetEnumerator()) {
                if ($null -eq $Attribute.Value) { continue Attributes }
                $AttributeString += " $($Attribute.Key)=`"$($Attribute.Value)`""
            }
        }
    }

    if ($Content) {
        $Content = $Content.Split("`n").foreach({ "`t$_" }) -join "`n"
        $XAML = "<$ElementType$AttributeString>`n$Content`n</$ElementType>"
    }
    else {
        $XAML = "<$ElementType$AttributeString/>"
    }

    if ($AsObject) {
        return ConvertTo-XAMLObject -XAML $XAML -XAMLElementType $ElementType
    }
    else {
        return $XAML
    }
}

function ConvertTo-XAMLObject {
    param(
        [parameter(ValueFromPipeline, Position = 0)]
        [string]$XAML,
        [string]$XAMLElementType
    )
    if ($XAML -notlike '*xmlns*') {
        if ($XAMLElementType -eq '') {
            $XAMLElementType = $XAML.Split("`n")[0].Split(' ')[0].Trim().TrimStart('<').TrimEnd('/>').TrimEnd('>')
        }
        $XAML = $XAML.Insert($XAMLElementType.Length + 1, ' xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ')
    }
    $stringReader = [System.IO.StringReader]::New($XAML)
    $xmlReader = [System.Xml.XmlReader]::Create($stringReader)
    Write-Verbose -Verbose:$XAMLVerbose -Message "[$(Get-Date)] [ConvertTo-XAMLObject] $XAML"
    return [System.Windows.Markup.XamlReader]::Load($xmlReader)
}

function _XAMLescapeSpecialCharacters {
    param($String)
    Write-Verbose -Verbose:$XAMLVerbose -Message "[$(Get-Date)] [_XAMLescapeSpecialCharacters] $String"
    $String = $String.Replace('\', '\\')
    $String = $String.Replace('&', '&amp;')
    $String = $String.Replace('<', '&lt;')
    $String = $String.Replace('>', '&gt;')
    $String = $String.Replace('"', '&quot;')
    $String = $String.Replace("'", '&apos;')
    $String = $String.Replace('{', '\{')
    $String = $String.Replace('}', '\}')

    return $String
}

#endregion Base Functions

#region Setup Functions

function Initialize-XAMLWindow {
    param(
        [parameter(ValueFromPipeline, Position = 0)]
        [string] $Xaml
    )
    Write-Verbose -Verbose:$XAMLVerbose -Message "[$(Get-Date)] [Initialize-XAMLWindow]"

    $Window = ConvertTo-XAMLObject -XAML $Xaml -XAMLElementType 'Window'
    $NamedElements = @{ Window = $Window }
    foreach ($Node in (([XML]$Xaml).SelectNodes('//*[@Name]'))) {
        $NamedElements."$($Node.Name)" = $Window.FindName($Node.Name)
    }

    return $NamedElements
}

function Show-XAMLWindow {
    param(
        [parameter(ValueFromPipeline, Position = 0)]
        $XAML
    )
    Write-Verbose -Verbose:$XAMLVerbose -Message "[$(Get-Date)] [Show-XAMLWindow]"

    if ($XAML -is [string]) {        
        $Elements = Initialize-XAMLWindow -Xaml $XAML
        $Elements
        $Elements.Window.ShowDialog() | Out-Null
    }
    else {
        $XAML.ShowDialog() | Out-Null
    }
}

#endregion Setup Functions

#region XAML Information

function Get-XAMLAttributes {
    param(
        [parameter(ValueFromPipeline, Position = 0)]
        [string] $ElementType,
        [string] $AttributeName,
        [switch] $SetAble
    )
    $Properties = New-XAMLElement $ElementType -AsObject | Get-Member -MemberType Property 
    if ($null -ne $AttributeName) {
        $Properties = $Properties | Where-Object { $_.Name -like "*$AttributeName*" }
    }
    if ($SetAble) {
        $Properties = $Properties | Where-Object -FilterScript { $_.Definition -match ';Set;' }
    }
    return $Properties
}

function Get-XAMLMethods {
    param(
        [parameter(ValueFromPipeline, Position = 0)]
        [string]$ElementType
    )
    New-XAMLElement $ElementType -AsObject | Get-Member -MemberType Method
}

function Get-XAMLEvents {
    param(
        [parameter(ValueFromPipeline, Position = 0)]
        [string]$ElementType
    )
    New-XAMLElement $ElementType -AsObject | Get-Member -MemberType Event
}

#endregion XAML Information

#region Make XAML Element Functions

function New-XAMLFunction {
    param($ElementType)
    try {
        @"
function New-XAML$ElementType {
    param(
        $(((Get-XAMLAttributes $ElementType -SetAble -ErrorAction Stop | ForEach-Object {
            "`t[$($_.Definition.Split(' ')[0].Trim())]`$$($_.name),"
        }) -join "`n").TrimEnd(",`n").TrimStart("`t"))
    )

    New-XAMLElement $ElementType ([hashtable]`$MyInvocation.BoundParameters)
}
"@
    }
    catch {
        Write-Host "No Such Element Exists: $ElementType.Error: $_"
    }
}

#endregion Make XAML Element Functions

